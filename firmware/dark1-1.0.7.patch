+/* Submit at most one mirror packet per millisecond and let pending MIDI and
+ * other SysEx go first. The USB driver never waits for the host here. */
+static int mirror_send(const uint8_t *message, unsigned length)
+{
+    static uint32_t last;
+    const uint32_t now = fm1_ms;
+    if (now == last || mo_r != mo_w || so_r != so_w ||
+        usb_sysex_try(message, length) != 0)
+        return -2;
+    last = now;
+    return 0;
+}
+
+static void mirror_service(void)
+{
+    static const uint8_t identity[] = {
+        0xf0, 0x7d, 'F', 'S', 3,
+        'D', 'A', 'R', 'K', '-', '1', ' ', '1', '.', '0', '.', '7', ' ', 'B', 'i', 'g', 'S', 'c', 'r', 'e', 'e', 'n',
+        0xf7
+    };
+    const uint32_t now = fm1_ms;
+    if (mirror_request) {
+        const uint32_t flags = irq_save();
+        const uint8_t full = mirror_full_request;
+        mirror_request = mirror_full_request = 0;
+        irq_restore(flags);
+        const uint8_t hello[] = { 0xf0, 0x7d, 'F', 'S', full, 0xf7 };
+        sm_sysex(hello, sizeof hello);
+        mirror_identify = 1;
+    }
+    sm_poll(now, mirror_send);
+    if (sm_take_full_request()) {
+        sm_length = sm_sent = 0;
+        mirror_ready = 0;
+        mirror_top = 0;
+    }
+    if (!sm_on()) {
+        mirror_ready = 0;
+        return;
+    }
+    if (mirror_identify && mirror_send(identity, sizeof identity) == 0)
+        mirror_identify = 0;
+    if (mirror_ready && !sm_length) {
+        const unsigned row = mirror_row;
+        if (sm_rows(mirror_pixels[row], 0, mirror_top + row, MIRROR_WIDTH, 1) &&
+            ++mirror_row == MIRROR_BAND) {
+            mirror_ready = 0;
+            mirror_top = (mirror_top + MIRROR_BAND) % MIRROR_WIDTH;
+        }
+    }
+}
+
