+/* Wait for the previous SysEx to drain and yield to pending MIDI. The USB
+ * poll sets the pace, with only one display message in the USB ring. */
+static int mirror_send(const uint8_t *message, unsigned length)
+{
+    if (mo_r != mo_w || so_r != so_w || usb_sysex_try(message, length) != 0)
+        return -2;
+    return 0;
+}
+
+static void mirror_service(void)
+{
+    static uint8_t identify;
+    static const uint8_t identity[] = {
+        0xf0, 0x7d, 'F', 'S', 3,
+        'D', 'A', 'R', 'K', '-', '1', ' ', '1', '.', '0', '.', '7', ' ', 'B', 'i', 'g', 'S', 'c', 'r', 'e', 'e', 'n',
+        ' ', 'F', 'a', 's', 't', 0xf7
+    };
+    if (mirror_request) {
+        const uint32_t flags = irq_save();
+        const uint8_t full = mirror_full_request;
+        mirror_request = mirror_full_request = 0;
+        irq_restore(flags);
+        const uint8_t hello[] = { 0xf0, 0x7d, 'F', 'S', full, 0xf7 };
+        sm_sysex(hello, sizeof hello);
+        identify = 1;
+    }
+    sm_poll(fm1_ms, mirror_send);
+    if (sm_take_full_request()) {
+        sm_length = sm_sent = 0;
+        mirror_reset();
+    }
+    if (!sm_on()) {
+        mirror_ready = 0;
+        return;
+    }
+    if (identify && mirror_send(identity, sizeof identity) == 0)
+        identify = 0;
+    mirror_stage();
+}
+
 static uint32_t prof_clk(void) { return fm1_ticks(); }
